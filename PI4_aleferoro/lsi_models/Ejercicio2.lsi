head section

Integer getNumCentros()
Integer getMaxCentros()
Integer getNumTematicas()
Integer getNumCursos()
Double getPrecioInscripcion(Integer i)
Integer contieneTematicaCurso(Integer i, Integer j)
Integer seImparteCursoEnCentro(Integer i, Integer k)

Integer m = getNumTematicas()
Integer n = getNumCursos()
Integer nc = getNumCentros()
Integer maxCentros = getMaxCentros()

goal section
min sum(getPrecioInscripcion(i) x[i],i in 0 .. n)

constraints section
sum(contieneTematicaCurso(i,j) x[i], i in 0 .. n)>=1, j in 0 .. m
sum(y[k], k in 0 .. nc)<= getMaxCentros()
seImparteCursoEnCentro(i,k) x[i] - y[k] <= 0, i in 0 .. n, k in 0 .. nc

bin
x[i], i in 0 .. n
y[k], k in 0 .. nc