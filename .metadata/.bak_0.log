					Stream2.file("ficheros/PI1Ej3DatosEntrada" + i + "B.txt").iterator());
			System.out.println("Test" + i + ": " + "Los siguientes " + li.size() + " puntos:\n " + li);
			System.out.println("#####Solucion Recursiva Final#####");
