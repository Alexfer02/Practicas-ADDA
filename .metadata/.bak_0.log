			System.out.println("---------RECURSIVA SIN MEMORIA---------");
			System.out.println("Test " + (i + 1) + ":"
					+ Ejercicio4.RecursivaSinMemoria(ob.first(), ob.second(), ob.third()) + "\n");
			System.out.println("---------RECURSIVA CON MEMORIA---------");
			System.out.println("Test " + (i + 1) + ":"
					+ Ejercicio4.RecursivaConMemoria(ob.first(), ob.second(), ob.third()) + "\n");
			System.out.println("---------ITERATIVA---------");
			System.out.println(
					"Test " + (i + 1) + ":" + Ejercicio4.Iterativa(ob.first(), ob.second(), ob.third()) + "\n");
		}
	}

