import datos.CiudadEjemplo;
import datos.Ciudad;
import datos.Trayecto;
import us.lsi.colors.GraphColors;
import us.lsi.colors.GraphColors.Color;
import us.lsi.graphs.views.SubGraphView;

public class Ejercicio2 {
	public static void vistaA(Graph<CiudadEjemplo, Trayecto> g, String file) {

		List<Set<CiudadEjemplo>> vista = new ConnectivityInspector<>(g).connectedSets();
		Integer tamaño = vista.size();
		System.out.println("Hay " + tamaño + " grupos de ciudades");
		for (int i = 1; i <= tamaño; i++) {
			System.out.println("Grupo numero " + i + ":" + vista.get(i - 1));
		}
		SubGraphView<CiudadEjemplo, Trayecto, Graph<CiudadEjemplo, Trayecto>> grafo1 = SubGraphView.of(g, vista.get(0));
		GraphColors.toDot(g, "resultados/ejercicio2/A" + file + ".gv", x -> x.nombre(), x -> "",
				v -> GraphColors.colorIf(Color.green, Color.yellow, grafo1.containsVertex(v)),
				e -> GraphColors.colorIf(Color.green, Color.yellow, grafo1.containsEdge(e)));
	}
	
	public static void ApartadoB(Graph<CiudadEjemplo, Trayecto> g, String file) {
		
		List<Set<CiudadEjemplo>> vista = new ConnectivityInspector<>(g).connectedSets();
