			System.out.println("Test" + i + ": " + "Los siguientes " + lrf.size() + " puntos:\n " + lrf);
			System.out.println("#####Solucion Funcional#####");
			//List<Punto2D> lf= Ejercicio3.funcional(Stream2.file("ficheros/PI1Ej3DatosEntrada" + i + "A.txt").iterator(),
